# Copy to .env and fill in values. Never commit .env to git.

# Required — get from https://console.groq.com (free tier)
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=llama3-8b-8192
MAX_RETRIES=3
MAX_ITERATIONS=8
MAX_EXECUTION_TIME=120

# TODO: Add domain-specific thresholds here.
# Example:
#   HIGH_RISK_AGE=60
#   MEDIUM_RISK_AGE=40
#   MAX_MISSED_VISITS=2
